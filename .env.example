# Development environment — copy to .env.dev and fill in values
# In launch.json set: "envFile": "${workspaceFolder}/hs-core-api/.env.dev"

# ===============================================================
# CORE APPLICATION
# ===============================================================
SPRING_PROFILES_ACTIVE=dev

# ===============================================================
# EUREKA SERVER
# ===============================================================
EUREKA_CLIENT_SERVICE_URL=http://localhost:8761/eureka

# ===============================================================
# INFRASTRUCTURE & DATA
# ===============================================================
DATASOURCE_URL=jdbc:postgresql://localhost:5432/homespace_core
DATASOURCE_USERNAME=homespace
DATASOURCE_PASSWORD=homespace123
JPA_DDL_AUTO=update

MONGODB_URI=mongodb://homespace:homespace123@localhost:27017/homespace_notification?authSource=admin

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=homespace123

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ===============================================================
# KEYCLOAK
# ===============================================================
KEYCLOAK_SERVER_URL=http://localhost:9000
KEYCLOAK_ADMIN_USERNAME=homespace
KEYCLOAK_ADMIN_PASSWORD=homespace123
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_CURRENT_REALM=homespace-platform
KEYCLOAK_CLIENT_ID=homespace-id

# ===============================================================
# BOOTSTRAP DATA
# ===============================================================
BOOTSTRAP_ADMIN_ENABLED=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PHONE_NUMBER=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
BOOTSTRAP_ADMIN_CCCD=075999999999

BOOTSTRAP_ADMIN_ENABLED_2=
BOOTSTRAP_ADMIN_USERNAME_2=
BOOTSTRAP_ADMIN_EMAIL_2=
BOOTSTRAP_ADMIN_PASSWORD_2=
BOOTSTRAP_ADMIN_PHONE_NUMBER_2=
BOOTSTRAP_ADMIN_FIRST_NAME_2=
BOOTSTRAP_ADMIN_LAST_NAME_2=
BOOTSTRAP_ADMIN_CCCD_2=075999999998
# Dev-only; requires both enabled bootstrap admins to use the same 12-digit CCCD.
# Never enable this for real signers or production data.
CCCD_TEST_SHARING_ENABLED=false

# ===============================================================
# AWS S3
# ===============================================================
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=homespace-dev-files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_S3_UPLOAD_URL_DURATION=10m
STORAGE_S3_DOWNLOAD_URL_DURATION=5m

# ===============================================================
# NOTIFICATION & OTP
# ===============================================================
NOTIFICATION_OTP_LENGTH=6
NOTIFICATION_OTP_TTL=3m
NOTIFICATION_OTP_RESEND_COOLDOWN=60s
NOTIFICATION_OTP_MAX_ATTEMPTS=5
NOTIFICATION_OTP_MAX_SENDS_PER_HOUR=5
OTP_HASH_SECRET=replace-with-at-least-32-random-characters

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-google-account@gmail.com
SMTP_PASSWORD=
SMTP_FROM=your-google-account@gmail.com
SMTP_FROM_NAME=HomeSpace

# ===============================================================
# DIDIT KYC
# ===============================================================
DIDIT_API_BASE_URL=https://verification.didit.me
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=

# ===============================================================
# PAYMENT & BANK ACCOUNT ENCRYPTION (AES-256)
# ===============================================================
HOMESPACE_BANK_ENCRYPTION_KEY=HomeSpaceBankEncSecretKey2026!#$

# ===============================================================
# PAYMENT PROOF MOBILE UPLOAD (PUBLIC GATEWAY BASE URL)
# ===============================================================
# - Đây là public URL trỏ tới API Gateway.
# - Không phải URL của hs-api-service port 8081.
# - Không thêm dấu slash ở cuối.
# - Development có thể dùng VS Code Dev Tunnel trỏ tới Gateway port 8080.
# - Production dùng domain thật của Gateway.
# Ví dụ development: PAYMENT_PROOF_UPLOAD_PUBLIC_BASE_URL=https://13zp4kj8-8080.asse.devtunnels.ms
# Ví dụ production:  PAYMENT_PROOF_UPLOAD_PUBLIC_BASE_URL=https://api.homespace.vn
PAYMENT_PROOF_UPLOAD_PUBLIC_BASE_URL=

# ===============================================================
# DOCX TO PDF (Gotenberg service in hs-infrastructure)
# Start: docker compose -f docker-infrastructure.yml up -d gotenberg
CONTRACT_GOTENBERG_URL=http://localhost:3001
CONTRACT_GOTENBERG_ENABLED=true

# VNPT SMARTCA REMOTE PDF SIGNATURE
# ===============================================================
# Giữ INTERNAL/false tới khi đã kiểm thử end-to-end trên môi trường VNPT được cấp.
CONTRACT_SIGNATURE_MODE=INTERNAL
SMARTCA_ENABLED=false
SMARTCA_BASE_URL=https://rmgateway.vnptit.vn/sca/sp769
# Thông tin SP của HomeSpace (không phải CCCD người ký), chỉ điền ở .env.dev.
SMARTCA_SP_ID=
SMARTCA_SP_PASSWORD=
SMARTCA_CONNECT_TIMEOUT=5s
SMARTCA_READ_TIMEOUT=30s
SMARTCA_POLL_INTERVAL=5000
SMARTCA_TRANSACTION_TIMEOUT=5m
# Webhook chưa được xác thực; kết quả ký được đồng bộ bằng backend scheduler.
SMARTCA_WEBHOOK_ENABLED=false
SMARTCA_WEBHOOK_PUBLIC_URL=
SMARTCA_PDF_SIGNATURE_REASON=Ky hop dong thue tren HomeSpace
SMARTCA_PDF_SIGNATURE_LOCATION=Viet Nam
