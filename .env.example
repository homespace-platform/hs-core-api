# Server-side address search (never expose this as a public frontend variable)
VIETMAP_API_KEY=

# Nearby amenity comparison (Geoapify Places). Leave the key blank to disable; never commit a real key.
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com
GEOAPIFY_DEFAULT_RADIUS_METERS=3000
GEOAPIFY_PAGE_SIZE=100
RECOMMENDATION_MAX_RESULTS=3

# Business clock only: blank = real time; nonblank allowed only in dev/test.
# Example: 2026-11-15T10:00:00 (Vietnam time, UTC+7). Restart Core after changing.
HOMESPACE_TIME_SIMULATED_AT=

# ===============================================================
# CORE APPLICATION
# ===============================================================
SPRING_PROFILES_ACTIVE=dev

# ===============================================================
# EUREKA SERVER
# ===============================================================
EUREKA_CLIENT_SERVICE_URL=http://localhost:8761/eureka

# ===============================================================
# INFRASTRUCTURE & DATA
# ===============================================================
DATASOURCE_URL=jdbc:postgresql://localhost:5432/homespace_core
DATASOURCE_USERNAME=homespace
DATASOURCE_PASSWORD=homespace123
JPA_DDL_AUTO=update

MONGODB_URI=mongodb://homespace:homespace123@localhost:27017/homespace_notification?authSource=admin

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=homespace123

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ===============================================================
# KEYCLOAK
