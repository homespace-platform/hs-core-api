# Development environment — copy to .env.dev and fill in values
# In launch.json set: "envFile": "${workspaceFolder}/hs-core-api/.env.dev"

# ===============================================================
# CORE APPLICATION
# ===============================================================
SPRING_PROFILES_ACTIVE=dev

# ===============================================================
# EUREKA SERVER
# ===============================================================
EUREKA_CLIENT_SERVICE_URL=http://localhost:8761/eureka

# ===============================================================
# INFRASTRUCTURE & DATA
# ===============================================================
DATASOURCE_URL=jdbc:postgresql://localhost:5432/homespace_core
DATASOURCE_USERNAME=homespace
DATASOURCE_PASSWORD=homespace123
JPA_DDL_AUTO=update

MONGODB_URI=mongodb://homespace:homespace123@localhost:27017/homespace_notification?authSource=admin

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=homespace123

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ===============================================================
# KEYCLOAK
# ===============================================================
KEYCLOAK_SERVER_URL=http://localhost:9000
KEYCLOAK_ADMIN_USERNAME=homespace
KEYCLOAK_ADMIN_PASSWORD=homespace123
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_CURRENT_REALM=homespace-platform
KEYCLOAK_CLIENT_ID=homespace-id

# ===============================================================
# BOOTSTRAP DATA
# ===============================================================
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=homespace
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=System
BOOTSTRAP_ADMIN_LAST_NAME=Administrator

# ===============================================================
# AWS S3
# ===============================================================
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=homespace-dev-files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_S3_UPLOAD_URL_DURATION=10m
STORAGE_S3_DOWNLOAD_URL_DURATION=5m

# ===============================================================
# LISTING PUBLICATION
# ===============================================================
LISTING_PUBLICATION_DURATION_DAYS=30
# Dev: 60000 = 1 minute; production: 3600000 = 1 hour
LISTING_EXPIRATION_CHECK_DELAY_MS=60000

# ===============================================================
# NOTIFICATION & OTP
# ===============================================================
NOTIFICATION_OTP_LENGTH=6
NOTIFICATION_OTP_TTL=3m
NOTIFICATION_OTP_RESEND_COOLDOWN=60s
NOTIFICATION_OTP_MAX_ATTEMPTS=5
NOTIFICATION_OTP_MAX_SENDS_PER_HOUR=5
OTP_HASH_SECRET=replace-with-at-least-32-random-characters

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-google-account@gmail.com
SMTP_PASSWORD=
SMTP_FROM=your-google-account@gmail.com
SMTP_FROM_NAME=HomeSpace
